# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MongoDB
# Local example: mongodb://localhost:27017/infinity_fsm
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/infinity_fsm

# JWT
# JWT_SECRET is accepted as an alias for JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Logging
LOG_LEVEL=info

# Cloudinary (required in production for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Socket.IO (falls back to CORS_ORIGINS when unset)
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase Cloud Messaging (server-side only — never put this in Flutter)
# Set FCM_ENABLED=false to disable push while developing without Firebase.
FCM_ENABLED=true
# Option A (recommended for cloud hosts): paste the full service-account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (local): absolute path to the service-account JSON file (do not commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Security — device clock tampering threshold (seconds)
DEVICE_CLOCK_SKEW_SECONDS=120

# Attendance
ATTENDANCE_GPS_ACCURACY_THRESHOLD_METERS=100

# Overtime
OVERTIME_MAX_REQUEST_HOURS=16
OVERTIME_MIN_REQUEST_HOURS=0.5
OVERTIME_MAX_SESSION_HOURS=16
OVERTIME_GPS_ACCURACY_THRESHOLD_METERS=100

# Mobile / desktop app release manifest (Update Center)
# Primary source: GitHub Releases (latest release + release-manifest.json asset).
# Fallback source: APP_RELEASE_* values below when GitHub is unavailable or unset.
APP_RELEASE_SOURCE=auto
APP_RELEASE_GITHUB_ENABLED=true
APP_RELEASE_GITHUB_OWNER=Mazen-Mahmoud-Mohamed
APP_RELEASE_GITHUB_REPO=infinity-fsm
APP_RELEASE_GITHUB_CACHE_TTL_MS=300000
# Optional server-side token for GitHub API rate limits or private repos.
GITHUB_RELEASE_TOKEN=

# Legacy fallback manifest (optional once GitHub Releases are configured).
APP_RELEASE_VERSION=1.0.0
APP_RELEASE_BUILD=1
APP_RELEASE_CHANNEL=stable
APP_RELEASE_DATE=
APP_RELEASE_NOTES=
APP_RELEASE_WINDOWS_URL=
APP_RELEASE_WINDOWS_SHA256=
APP_RELEASE_WINDOWS_SIZE=
APP_RELEASE_ANDROID_URL=
APP_RELEASE_ANDROID_SHA256=
APP_RELEASE_ANDROID_SIZE=

# Optional GitHub webhook secret for release push notifications (HMAC SHA-256).
GITHUB_RELEASE_WEBHOOK_SECRET=
